version: "3.9"

services:
  web:
    build:
      context: .
      dockerfile: Dockerfile
    image: sierraleoneieltsprep
    container_name: flask_app
    restart: always
    ports:
      - "5000:5000"
    environment:
      FLASK_CONFIG: production
      SECRET_KEY: super-secret-key
      JWT_SECRET_KEY: super-jwt-secret
      DATABASE_URL: postgresql://ielts_user:ielts_password@db:5432/ielts_prep
    depends_on:
      - db

  db:
    image: postgres:15
    container_name: postgres_db
    restart: always
    environment:
      POSTGRES_USER: ielts_user
      POSTGRES_PASSWORD: ielts_password
      POSTGRES_DB: ielts_prep
    volumes:
      - postgres_data:/var/lib/postgresql/data

volumes:
  postgres_data:
